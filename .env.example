# Copy to .env.local and fill in.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/zoxen_dashboard
MONGODB_DB=zoxen_dashboard

# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS='abcd efgh ijkl mnop'
# Where reminders go (defaults to SMTP_USER). Can also be changed in Settings.
NOTIFY_EMAIL=

# Protects /api/cron when deployed (call /api/cron?key=THIS every minute from cron-job.org)
CRON_SECRET=change-me
